APP__DB__HOST='localhost'
APP__DB__PORT=5432

APP__DB__DATABASE=data_base
APP__DB__USER=user
APP__DB__PASSWORD=pass

APP__DB__ECHO=0             # Виводити логи DB
APP__DB__ECHO_POOL=0        # Виводити більш широкі логи
APP__DB__POOL_SIZE=5        # кількість відкрити з'єднань
APP__DB__MAX_OVERFLOW=10    # кількість підключень в пулі

# Токен для Time Camp
APP__TC__TOKEN=

# Токен для JIRA
APP__JIRA__TOKEN=
# Основной Юзер Jira (legacy fallback для CLI/notebook; HTTP API бере worker_key із api_users)
APP__CURRENT_USER=

# ---- HTTP API ----
# bind host/port для uvicorn.
# Порт за конвенцією: 10xxx — сервіси (api=10331), 11xxx — БД (postgres=11331).
APP__API__HOST=0.0.0.0
APP__API__PORT=10331
# секрет для підпису JWT (HS256). Згенерувати: python -c 'import secrets; print(secrets.token_hex(32))'
# обов'язковий — без нього API не стартує
APP__API__JWT_SECRET=
# TTL access-токена в годинах
APP__API__JWT_TTL_HOURS=24
# CORS — comma-separated список origin-ів або "*" для локалки.
# У dev фронт ходить в API через Vite-проксі (один origin), тож CORS —
# запасний шлях для прямих звернень. Front dev-origin: http://localhost:11332
APP__API__CORS_ORIGINS=*
