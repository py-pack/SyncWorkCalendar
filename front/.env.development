# Dev-дефолти (комітяться). Реальні секрети сюди не клади.
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://localhost:10331

# Публічний Google OAuth client_id (One Tap / popup). Порожній = Google-вхід
# вимкнено, лишається логін/пароль. Локально задай у front/.env (gitignore).
VITE_GOOGLE_CLIENT_ID=
