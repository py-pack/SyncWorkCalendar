# Базовий префікс REST API, який використовує HTTP-клієнт фронтенду.
# У dev цей префікс проксується Vite на бекенд (див. vite.config.ts).
VITE_API_BASE_URL=/api

# Ціль dev-проксі Vite. Локально — http://localhost:10331 (host-порт бекенду).
# У docker-compose перевизначається на http://api:10331 (ім'я сервісу).
VITE_API_PROXY_TARGET=http://localhost:10331

# HMR за host-nginx (кастомні домени) — опційно, дві змінні:
#   VITE_HMR_HOST  — домен (напр. sync.dev); без нього HMR за дефолтом Vite.
#   VITE_HMR_HTTPS — true/false; виводить protocol(wss/ws) і clientPort(443/80).
# (за потреби можна явно: VITE_HMR_PROTOCOL, VITE_HMR_CLIENT_PORT)
# VITE_HMR_HOST=sync.dev
# VITE_HMR_HTTPS=true
